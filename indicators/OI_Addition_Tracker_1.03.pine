//@version=6
indicator("OI Addition Tracker 1.03", "OIAT", overlay=true, calc_bars_count=500)

// ═══════════════════════════════════════════════════════════════════════════
// OI ADDITION TRACKER 1.03 — an indicator for TradingView's Pine Screener
//   Tracks how consistently futures OI has been ADDED over the last few closed candles.
//   Run it on a watchlist of F&O stocks' CASH symbols (for example NSE:RELIANCE), on ANY intraday timeframe.
//   Only closed candles are used. Example: 30 min chart at 09:45 → the latest closed candle is 09:15–09:45, and the
//   10 bars are that candle plus the 9 closed candles before it (going back into the previous day when needed).
//
//   THE CANDLE TO SCAN (the "Candle" setting, as in First Candle OI Screener 1.05)
//     · by default the LATEST CLOSED candle, or
//     · the candle you pick: the candle of the latest day that contains that time (on 15 min, 09:30 and 09:40 both
//       pick 09:30–09:45). It is shown once that candle has closed; until then the columns stay empty.
//     Everything is then worked out AS AT THAT CANDLE'S CLOSE: the 10 bars end with it, the average comes from the
//     candles before those bars, and relative volume and child % are its own. Nothing after it is used.
//
//   EACH BAR (its exact window)
//     ΔOI      = near-month (1!) OI change + next-month (2!) OI change over that candle. Fresh, not cumulative.
//     OV ratio = 100 × ΔOI ÷ (near-month volume + next-month volume) over the same candle. Never cash volume.
//     Valid only when both contracts' OI and volume candles start exactly with the cash candle and each contract's
//     previous OI print is the cash chart's previous candle or later, on the same date (as First Candle OI Screener 1.05).
//     Contract-roll morning (1! and 2! switched contracts overnight): the day's first candle uses the one contract
//     both days share (today's near month = yesterday's next month), for ΔOI and OV alike (as 1.05). It counts in the
//     bars checked, but stays out of the average.
//     Anything else (missing or misaligned candle, OV above 100%) is NOT valid: that bar is left out of every count,
//     and "Valid bars" shows how many of the bars were usable.
//     Added   = a valid bar with ΔOI > 0.
//
//   THE AVERAGE (the yardstick)
//     Avg ΔOI and avg OV ratio = the mean of every valid candle that ADDED OI in the N candles BEFORE the bars being
//     checked (any time of day, green or red, roll mornings left out). The checked bars never count towards their own
//     average.
//     "Above average" means strictly greater than the average.
//
//   RELATIVE VOLUME (cash, the scanned candle only)
//     = the scanned candle's cash volume ÷ the average cash volume of the candles that started at the SAME
//       time of day on the last N earlier days. 100 = normal for that time of day, 250 = 2.5 times normal.
//     Empty when fewer than the minimum number of earlier days are loaded (1 and 3 min charts in the screener).
//
//   THE PREVIOUS DAY (the trading day before the latest day) — the same method as 1.05
//     Built from the chart's own candles and each futures series' own data, with no daily requests: each futures
//     series records its LAST print of every day itself (including F&O trading after 15:30, and whatever candles come
//     before 09:15), and today's first futures candle that exists hands it over.
//     PD OI added %    = (near + next OI at that day's last print − near + next OI at the day before's last print)
//                        ÷ the earlier OI. On a contract-roll day: the one contract both days share.
//     PD open to close = the stock's cash close ÷ cash open of that day − 1, in % (empty only for the first day loaded).
//
//   SCREENER COLUMNS (the first 10 plots, in this order)
//     OI-added bars        how many of the valid bars added OI
//     ΔOI above avg %      of the OI-added bars, the % whose ΔOI is above avg ΔOI (4 of 5 = 80)
//     OV above avg %       of the OI-added bars, the % whose OV ratio is above avg OV ratio
//     Highest ΔOI % of avg the biggest ΔOI among the OI-added bars, as a % of avg ΔOI (200 = twice the average)
//     Highest OV % of avg  the biggest OV ratio among the OI-added bars, as a % of avg OV ratio
//     Rel volume %         the scanned candle's cash relative volume (see above)
//     PD OI added %        the previous day's near + next OI change, % of the OI before it (+ added, − reduced)
//     PD open to close %   the previous day's cash open to close, %
//     Child %              the biggest child candle's share of the scanned candle's cash volume
//     Valid bars           how many of the bars checked had usable futures data (10 = all of them)
//     Candle time          the scanned candle's start, exchange time, as YYMMDDHHMM (2611250930 = 25 Nov 2026 09:30)
//   (1.03 test: 11 screener columns, to see whether the Pine Screener shows more than 10.)
//   Also in the data window and the chart table (not screener columns): Green % of OI-added bars, Avg ΔOI,
//   Avg OV ratio %, Avg count.
//
//   A candle is closed once its end time has passed (or, live, on its last tick), so after the market closes the
//   day's last candle (15:15–15:30 on 15 min) counts too.
//   The chart calculates on the last 500 candles only (calc_bars_count=500), exactly like the Pine Screener. This also
//   limits the futures requests the same way, so the chart and the screener show the same numbers. (With full chart
//   history the futures series reach further back than in the screener, and the averages differed slightly.)
//   No repainting: a candle is read only after it has closed, every request uses lookahead_off, and nothing comes
//   from a later candle. Pine Screener limits respected: 5 data requests (exactly 5 here), no timeframe or symbol
//   inputs, no time inputs other than the "Candle" list, and only the last 500 candles of history (see the settings under "Averages").
// ═══════════════════════════════════════════════════════════════════════════

// ───────────────────────────────── INPUTS ─────────────────────────────────
grpS    = "Candle to scan"
slotIn  = input.string("Latest closed candle", "Candle", options=["Latest closed candle", "09:15", "09:20", "09:25", "09:30", "09:35", "09:40", "09:45", "09:50", "09:55", "10:00", "10:05", "10:10", "10:15", "10:20", "10:25", "10:30", "10:35", "10:40", "10:45", "10:50", "10:55", "11:00", "11:05", "11:10", "11:15", "11:20", "11:25", "11:30", "11:35", "11:40", "11:45", "11:50", "11:55", "12:00", "12:05", "12:10", "12:15", "12:20", "12:25", "12:30", "12:35", "12:40", "12:45", "12:50", "12:55", "13:00", "13:05", "13:10", "13:15", "13:20", "13:25", "13:30", "13:35", "13:40", "13:45", "13:50", "13:55", "14:00", "14:05", "14:10", "14:15", "14:20", "14:25", "14:30", "14:35", "14:40", "14:45", "14:50", "14:55", "15:00", "15:05", "15:10", "15:15", "15:20", "15:25"], group=grpS, display=display.none, tooltip="Latest closed candle: the newest candle that has closed.\nA time: the candle of the latest day that contains that time, for example 09:15 for the first candle. On 15 min, 09:30 and 09:40 both pick 09:30–09:45. It shows once that candle has closed.")

grpB  = "The bars to check"
kBars = input.int(10, "Bars to check", minval=1, maxval=50, group=grpB, display=display.none, tooltip="How many closed candles to check, ending with the candle to scan. 10 = that candle and the 9 before it, going back into the previous day when its day has fewer.")

grpA = "Averages"
avgN = input.int(488, "Average from the N candles before those bars", minval=10, maxval=5000, group=grpA, display=display.none, tooltip="Avg ΔOI and avg OV ratio come from every candle that added OI among these N candles, which sit just before the bars being checked. The Pine Screener holds only 500 candles, and this indicator limits the chart to the same 500: keep (bars to check + N) at 498 or less. 10 + 488 = 498. The oldest candles can lack futures data (futures series have a few more candles a day than the stock), so Avg count in the data window shows how many candles really make up the average. On 15 min that is about 19 days, on 5 min about 6.\nWith a picked candle, the window still ends at the latest closed candle (the screener holds nothing older), so the candles after the picked one take the place of the oldest ones: on 15 min at most 24 fewer.")

grpR   = "Relative volume (cash)"
rvDays = input.int(20, "Normal volume: same time of day on the last N days", minval=1, maxval=60, group=grpR, display=display.none, tooltip="Normal volume = the average cash volume of the candles that started at the same time as the candle to scan, on up to this many earlier days. Only days inside the same window as the averages (bars to check + N candles) are used, so the chart and the screener agree.")
rvMin  = input.int(5, "Fewest days needed", minval=1, maxval=60, group=grpR, display=display.none, tooltip="With fewer earlier days than this, relative volume is left empty rather than shown from too few days. In the screener that happens on 1 and 3 min charts, because 500 candles hold only 1 to 4 days there.")

grpC = "Child contribution"
chTf = input.string("1 minute", "Child candle size", options=["1 second", "5 seconds", "10 seconds", "15 seconds", "30 seconds", "1 minute"], group=grpC, display=display.none, tooltip="The size of the small candles inside the candle to scan. Child % = the biggest one's share of the candle's cash volume. Seconds need a Premium plan or higher, and the child must be shorter than the chart's candle (so on a 1 min chart pick seconds).")

grpD  = "Chart"
tblOn = input.bool(true, "Table of the bars checked", group=grpD, display=display.none, tooltip="Shown on a chart only, for checking the numbers bar by bar. The screener does not use it.")

// ─────────────────────────── CHART CHECK AND CONSTANTS ───────────────────────────
if not timeframe.isminutes
    runtime.error("OI Addition Tracker: use an intraday timeframe from 1 minute to 4 hours.")

const string NOSYM = "NSE:OIAT_NO_SYMBOL_0"        // deliberately invalid: a request that is not needed loads nothing
int    W        = kBars + avgN                     // the whole window: the bars to check + the candles before them
int    TF_MS    = timeframe.in_seconds() * 1000
int    CH_SEC   = chTf == "1 second" ? 1 : chTf == "5 seconds" ? 5 : chTf == "10 seconds" ? 10 : chTf == "15 seconds" ? 15 : chTf == "30 seconds" ? 30 : 60
string CH_TF    = CH_SEC < 60 ? str.tostring(CH_SEC) + "S" : "1"
bool   CH_OK    = CH_SEC * 1000 < TF_MS            // a child must be shorter than the chart candle
int    CH_BARS  = math.round(48000.0 / CH_SEC)     // child candles in two sessions of 400 minutes: covers the latest session
bool   SLOT_ON  = slotIn != "Latest closed candle"
int    SLOT_H   = SLOT_ON ? math.round(str.tonumber(str.substring(slotIn, 0, 2))) : 9
int    SLOT_M   = SLOT_ON ? math.round(str.tonumber(str.substring(slotIn, 3, 5))) : 15

// ─────────────────────────────── UTILITIES ───────────────────────────────
// One time of day's cash volumes from earlier days, newest last
type Slot
    array<float> v                             // the candle's cash volume
    array<int>   n                             // its closed-candle number, to keep it inside the window
f_at(int t, int h, int m) => timestamp(syminfo.timezone, year(t), month(t), dayofmonth(t), h, m, 0)
f_ymd(int t) => year(t) * 10000 + month(t) * 100 + dayofmonth(t)
// A futures value's previous candle belongs to the cash chart's previous candle: same date, and not earlier
f_prevOk(int prevT, float prevV, int pt) => not na(pt) and not na(prevT) and prevT >= pt and f_ymd(prevT) == f_ymd(pt) and not na(prevV)

// ─────────────────────────────── DATA REQUESTS (5) ───────────────────────────────
// Futures: near month (1!) and next month (2!) of the same stock, the chart's timeframe, gaps_on (no futures candle
// at this time = na, never a carried value), lookahead_off. Each request returns its own candle's time, so the
// alignment with the cash candle is checked, not assumed.
// Each futures OI series also keeps its own previous day's LAST print (and its time), worked out inside the futures
// series itself, so it never depends on which cash candles come before today's first one (as 1.05).
string EXCH = syminfo.prefix == "BSE" ? "NSE" : syminfo.prefix
string FUT1 = EXCH + ":" + syminfo.ticker + "1!"
string FUT2 = EXCH + ":" + syminfo.ticker + "2!"
f_oiReq() =>                                       // this OI candle, the one before it, and the previous day's last OI
    var float eod  = na
    var int   eodT = na
    if not na(time[1]) and f_ymd(time) != f_ymd(time[1])
        eod  := close[1]
        eodT := time[1]
    [time, close, time[1], close[1], eod, eodT]
[n1T, n1C, n1PT, n1PC, n1E, n1ET] = request.security(FUT1 + "_OI", timeframe.period, f_oiReq(), gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
[n2T, n2C, n2PT, n2PC, n2E, n2ET] = request.security(FUT2 + "_OI", timeframe.period, f_oiReq(), gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
[v1T, v1V] = request.security(FUT1, timeframe.period, [time, volume], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
[v2T, v2V] = request.security(FUT2, timeframe.period, [time, volume], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
// Child candles: the stock's own cash volume, one value per child candle inside this chart candle (with its start time)
[cT, cV] = request.security_lower_tf(CH_OK ? syminfo.tickerid : NOSYM, CH_TF, [time, volume], ignore_invalid_symbol=true, ignore_invalid_timeframe=true, calc_bars_count=CH_BARS)

// ─────────────────────────────── CANDLE AND DAY ───────────────────────────────
// A candle counts only once it has closed: live, on its last tick; otherwise once its end time has passed. The time
// test guards the screener's last candle while it is forming, and lets the day's last candle count after the close.
bool closed = barstate.isrealtime ? barstate.isconfirmed : (na(timenow) or time_close <= timenow)
int  bD0    = f_at(time, 9, 15)
bool inDay  = time >= bD0 and time < f_at(time, 16, 0)     // the regular day (no evening special sessions)
bool cBar   = closed and inDay                              // a closed candle of the regular day
int  pT     = time[1]                                       // the cash chart's previous candle
var int dayKey = na
bool newDay = cBar and (na(dayKey) or bD0 != dayKey)        // the day's first closed candle

// ─────────────────────────────── THIS CANDLE'S FUTURES ───────────────────────────────
bool o1 = not na(n1T) and n1T == time and n1C > 0 and f_prevOk(n1PT, n1PC, pT) and n1PC > 0
bool o2 = not na(n2T) and n2T == time and n2C > 0 and f_prevOk(n2PT, n2PC, pT) and n2PC > 0
bool q1 = not na(v1T) and v1T == time and not na(v1V)
bool q2 = not na(v2T) and v2T == time and not na(v2V)
// Contract roll (only overnight): today's near month looks like yesterday's next month
bool roll = newDay and o1 and o2 and math.abs(n1C - n2PC) < math.abs(n1C - n1PC)
float cD  = na                                     // this candle's ΔOI (na = not valid)
float cO  = na                                     // this candle's OV ratio (na = not valid)
// Why a candle is not valid (shown per bar in the chart table): 0 valid · 1 near-month OI · 2 next-month OI
// · 3 near-month volume · 4 next-month volume · 5 OV above 100% · 6 no futures volume
int   cWhy = 0
if roll
    if q1 and v1V > 0
        float d = n1C - n2PC                       // today's near month = yesterday's next month: the same contract
        float o = 100.0 * d / v1V
        if math.abs(o) <= 100.0                    // above 100% is impossible inside one window: misaligned data
            cD := d
            cO := o
        else
            cWhy := 5
    else
        cWhy := not q1 ? 3 : 6
else if o1 and o2 and q1 and q2 and v1V + v2V > 0
    float d = (n1C - n1PC) + (n2C - n2PC)
    float o = 100.0 * d / (v1V + v2V)
    if math.abs(o) <= 100.0
        cD := d
        cO := o
    else
        cWhy := 5
else
    cWhy := not o1 ? 1 : not o2 ? 2 : not q1 ? 3 : not q2 ? 4 : 6

// ─────────────────────────────── STATE ───────────────────────────────
// Rolling window of the last W closed candles, oldest first
var array<int>   hT = array.new_int()          // the candle's open time
var array<float> hD = array.new_float()        // its ΔOI (na = not valid)
var array<float> hO = array.new_float()        // its OV ratio (na = not valid)
var array<bool>  hG = array.new_bool()         // it closed green (close above open)
var array<bool>  hR = array.new_bool()         // it is a roll-morning candle (shared contract only: kept out of the average)
var array<int>   hW = array.new_int()          // why it is not valid (cWhy)
var int cbN = 0                                // closed candles counted so far
// Same-time-of-day cash volume: one list per time of day, newest last, at most rvDays + 1 entries
var map<int, Slot> slots = map.new<int, Slot>()
// The candle to scan (the latest closed one, or the picked one)
var int   tT    = na
var int   tC    = na                           // its closed-candle number (cbN)
var float tV    = na                           // its cash volume
var float tRv   = na                           // relative volume, %
var float tRvA  = na                           // normal volume for its time of day
var int   tRvN  = 0                            // how many earlier days make up that normal volume
var int   tRvK  = na                           // its time of day (hour × 60 + minute)
var float chSh  = na                           // child share, %
var float chCov = na                           // the children's volume ÷ the candle's volume, %
var int   chT   = na                           // the biggest child's start time
var int   chCd  = 1                            // 0 valid · 1 no child data · 2 child not shorter than the chart candle · 3 children do not add up
// The day in progress (as 1.05)
var bool  dPrev  = false                       // the day before it was seen in full (so this day is not a partial first day)
var float dOpen  = na
var float dClose = na
var int   dLastT = na                          // its latest closed candle's open time
var int   pvYmd  = na                          // the date of the day before it
// Its start = the day before's last prints, captured on its first candle that has futures data
var bool  stOI  = false
var float sP1   = na
var float sP2   = na
var bool  sRoll = false                        // 1! and 2! switched contracts between the day before and this day
// The previous day's start, waiting for its end (the last prints, seen on today's candles)
var bool  wPend = false
var bool  wOk   = false
var float wP1   = na
var float wP2   = na
var bool  wRoll = false
// The previous day = the newest finished day
var int   pdT    = na                          // its 09:15
var float pOI    = na                          // its OI added, %
var float pOC    = na                          // its cash open to close, %
var bool  pdRoll = false                       // it was a contract-roll day: the shared contract only

// ─────────────────────────────── A NEW DAY: finish the previous one ───────────────────────────────
if newDay
    if not na(dayKey)
        pdT    := dayKey
        pOI    := na                       // filled in below, once today's futures data shows that day's last prints
        pOC    := dPrev and dOpen > 0 ? 100.0 * (dClose - dOpen) / dOpen : na
        pdRoll := sRoll
        // Its start values now wait for its end values
        wPend := true
        wOk   := stOI
        wP1   := sP1
        wP2   := sP2
        wRoll := sRoll
    // Start the new day
    dPrev  := not na(dLastT)
    pvYmd  := na(dLastT) ? na : f_ymd(dLastT)
    dayKey := bD0
    dOpen  := open
    stOI   := false
    sP1    := na
    sP2    := na
    sRoll  := false
    if SLOT_ON
        tT := na                           // the picked candle of a new day has not closed yet
        tC := na

// ─────────── EVERY CLOSED CANDLE: the previous day's last prints, from today's futures candles (as 1.05) ───────────
if cBar and not na(pvYmd)
    // Both series have a candle with this cash candle, and their recorded last prints are from the day before
    if not stOI and not na(n1T) and n1T == time and not na(n2T) and n2T == time and not na(n1ET) and not na(n2ET) and f_ymd(n1ET) == pvYmd and f_ymd(n2ET) == pvYmd and n1E > 0 and n2E > 0 and n1C > 0
        stOI  := true
        sP1   := n1E
        sP2   := n2E
        sRoll := math.abs(n1C - n2E) < math.abs(n1C - n1E)
        if wPend
            wPend := false
            if wOk
                // the previous day's ΔOI: near + next, or on a roll day the one contract both its ends share
                float dd   = wRoll ? n1E - wP2 : (n1E + n2E) - (wP1 + wP2)
                float base = wRoll ? wP2 : wP1 + wP2
                pOI := 100.0 * dd / base

// ─────────────────────────────── EVERY CLOSED CANDLE ───────────────────────────────
if cBar
    cbN += 1
    dClose := close
    dLastT := time
    // Into the rolling window
    hT.push(time)
    hD.push(cD)
    hO.push(cO)
    hG.push(close > open)
    hR.push(roll)
    hW.push(cWhy)
    while hT.size() > W
        hT.shift()
        hD.shift()
        hO.shift()
        hG.shift()
        hR.shift()
        hW.shift()
    // Same time of day list for this candle
    int  sk = hour(time, syminfo.timezone) * 60 + minute(time, syminfo.timezone)
    Slot sl = slots.get(sk)
    if na(sl)
        sl := Slot.new(array.new_float(), array.new_int())
        slots.put(sk, sl)
    // The candle to scan: the latest closed one, or the one that contains the picked time (as 1.05)
    int  slotT  = f_at(time, SLOT_H, SLOT_M)
    bool isSlot = SLOT_ON and time <= slotT and slotT < time + TF_MS
    if not SLOT_ON or isSlot
        tT   := time
        tC   := cbN
        tV   := volume
        tRvK := sk
    // Child data covers about the last two days, so child % is worked out only where it can be shown
    if (not SLOT_ON and bar_index >= last_bar_index - 1) or isSlot
        // Child contribution: exact only, so the child candles must add up to the candle's own volume
        chSh  := na
        chCov := na
        chT   := na
        chCd  := 1
        if not CH_OK
            chCd := 2
        else if not na(cV) and not na(cT) and cV.size() > 0 and volume > 0
            float cs = 0.0
            float cb = -1.0
            int   ct = na
            for i = 0 to cV.size() - 1
                float v = nz(cV.get(i))
                cs += v
                if v > cb
                    cb := v
                    ct := cT.get(i)
            chCov := 100.0 * cs / volume
            chT   := ct
            if math.abs(cs - volume) < 0.5
                chSh := 100.0 * cb / volume
                chCd := 0
            else
                chCd := 3
    // Then add this candle to its time-of-day list
    if not na(volume)
        sl.v.push(volume)
        sl.n.push(cbN)
        if sl.v.size() > rvDays + 1            // + 1: the scanned candle's own day sits in its list too
            sl.v.shift()
            sl.n.shift()

// ─────────────────────────────── THE BARS CHECKED AND THEIR AVERAGE ───────────────────────────────
// The arrays hold the last W closed candles. The scanned candle sits (cbN - tC) places before the newest one; the
// candles after it are never used.
int   hn   = hT.size()
int   e    = na(tC) ? -1 : hn - 1 - (cbN - tC)  // index of the scanned candle (-1 = none, or older than the window)
int   kk   = e >= 0 ? math.min(kBars, e + 1) : 0 // bars actually checked (fewer only when history is short)
int   b0   = e - kk + 1                         // index of the oldest bar checked; the average uses 0 .. b0 - 1
float aOI  = na                                 // avg ΔOI
float aOV  = na                                 // avg OV ratio
int   aN   = 0                                  // candles that make up the average
int   nV   = 0                                  // valid bars
int   nA   = 0                                  // OI-added bars
int   nAO  = 0                                  // OI-added bars with ΔOI above avg
int   nAV  = 0                                  // OI-added bars with OV ratio above avg
int   nG   = 0                                  // OI-added bars that closed green
float mxD  = na                                 // the biggest ΔOI among the OI-added bars
float mxO  = na                                 // the biggest OV ratio among the OI-added bars
int   mxDT = na
int   mxOT = na
if barstate.islast and kk > 0
    float zD = 0.0
    float zO = 0.0
    if b0 > 0
        for i = 0 to b0 - 1
            float d = hD.get(i)
            if not na(d) and d > 0 and not hR.get(i)
                zD += d
                zO += hO.get(i)
                aN += 1
    aOI := aN > 0 ? zD / aN : na
    aOV := aN > 0 ? zO / aN : na
    for i = b0 to e
        float d = hD.get(i)
        if not na(d)
            nV += 1
            if d > 0
                float o = hO.get(i)
                nA += 1
                nAO += not na(aOI) and d > aOI ? 1 : 0
                nAV += not na(aOV) and o > aOV ? 1 : 0
                nG  += hG.get(i) ? 1 : 0
                if na(mxD) or d > mxD
                    mxD  := d
                    mxDT := hT.get(i)
                if na(mxO) or o > mxO
                    mxO  := o
                    mxOT := hT.get(i)
// Relative volume of the scanned candle: the same time of day on earlier days, inside the window, newest first
if barstate.islast and kk > 0
    float s = 0.0
    int   c = 0
    Slot  sl = slots.get(tRvK)
    if not na(sl) and sl.v.size() > 0
        for i = sl.v.size() - 1 to 0
            if c >= rvDays
                break
            int n = sl.n.get(i)
            if n < tC and n > cbN - W              // an earlier day, and inside the window
                s += sl.v.get(i)
                c += 1
    tRvN := c
    tRvA := c > 0 ? s / c : na
    tRv  := c >= rvMin and s > 0 and not na(tV) ? 100.0 * tV / (s / c) : na
f_pc(float v, float a) => na(v) or na(a) or a <= 0 ? na : 100.0 * v / a

// ─────────────────────────────── SCREENER COLUMNS (the first 10 plots) ───────────────────────────────
// Not drawn on the chart: the values appear in the Pine Screener and in the chart's data window.
bool  show  = kk > 0 and not na(tT)
float oA    = show and nV > 0 ? nA : na
float oAO   = show and nA > 0 and not na(aOI) ? 100.0 * nAO / nA : na
float oAV   = show and nA > 0 and not na(aOV) ? 100.0 * nAV / nA : na
float oMxD  = show ? f_pc(mxD, aOI) : na
float oMxO  = show ? f_pc(mxO, aOV) : na
float oRv   = show ? tRv : na
float oPOI  = show ? pOI : na
float oPOC  = show ? pOC : na
float oCh   = show ? chSh : na
float oV    = show ? nV : na
float oTs   = show ? (year(tT, syminfo.timezone) % 100) * 100000000.0 + month(tT, syminfo.timezone) * 1000000.0 + dayofmonth(tT, syminfo.timezone) * 10000.0 + hour(tT, syminfo.timezone) * 100.0 + minute(tT, syminfo.timezone) : na
float oG    = show and nA > 0 ? 100.0 * nG / nA : na
float oAOI  = show ? aOI : na
float oAOV  = show ? aOV : na
float oAN   = show ? aN : na
plot(oA, "OI-added bars", #2962FF, display=display.all - display.pane - display.price_scale - display.status_line, precision=0)
plot(oAO, "ΔOI above avg %", #26A69A, display=display.all - display.pane - display.price_scale - display.status_line, precision=1)
plot(oAV, "OV above avg %", #26A69A, display=display.all - display.pane - display.price_scale - display.status_line, precision=1)
plot(oMxD, "Highest ΔOI % of avg", #26A69A, display=display.all - display.pane - display.price_scale - display.status_line, precision=1)
plot(oMxO, "Highest OV % of avg", #26A69A, display=display.all - display.pane - display.price_scale - display.status_line, precision=1)
plot(oRv, "Rel volume %", #FF9800, display=display.all - display.pane - display.price_scale - display.status_line, precision=1)
plot(oPOI, "PD OI added %", #9C27B0, display=display.all - display.pane - display.price_scale - display.status_line, precision=2)
plot(oPOC, "PD open to close %", #9C27B0, display=display.all - display.pane - display.price_scale - display.status_line, precision=2)
plot(oCh, "Child %", #00ACC1, display=display.all - display.pane - display.price_scale - display.status_line, precision=1)
plot(oV, "Valid bars", #787B86, display=display.all - display.pane - display.price_scale - display.status_line, precision=0)
plot(oTs, "Candle time", #787B86, display=display.all - display.pane - display.price_scale - display.status_line, precision=0)
// Data window only (after the first 11, so not screener columns)
plot(oG, "Green % of OI-added bars", #787B86, display=display.data_window, precision=1)
plot(oAOI, "Avg ΔOI", #787B86, display=display.data_window, format=format.volume)
plot(oAOV, "Avg OV ratio %", #787B86, display=display.data_window, precision=2)
plot(oAN, "Avg count", #787B86, display=display.data_window, precision=0)

// ─────────────────────────────── TABLE (chart only) ───────────────────────────────
f_cell(table t, int c, int r, string s, color tc, color bg = na) =>
    table.cell(t, c, r, s, text_color=tc, bgcolor=bg, text_size=size.small, text_halign=text.align_left)
f_k(float v) => na(v) ? "–" : (v > 0 ? "+" : "") + str.tostring(v, format.volume)
f_p(float x) => na(x) ? "–" : str.tostring(x, "0.0") + "%"
f_sp(float x) => na(x) ? "–" : (x > 0 ? "+" : "") + str.tostring(x, "0.00") + "%"
f_hm(int t) => na(t) ? "–" : str.format_time(t, "dd MMM HH:mm", syminfo.timezone)
// Why a bar has no usable data, in words
f_why(int w) => w == 1 ? "no usable data: near-month (1!) OI candle missing or not continuous" : w == 2 ? "no usable data: next-month (2!) OI candle missing or not continuous" : w == 3 ? "no usable data: near-month (1!) volume candle missing" : w == 4 ? "no usable data: next-month (2!) volume candle missing" : w == 5 ? "no usable data: OV above 100% (OI and volume not from the same window)" : "no usable data: no futures volume"
f_of(int a, int b) => str.tostring(a) + " of " + str.tostring(b) + (b > 0 ? " = " + str.tostring(100.0 * a / b, "0") + "%" : "")

int ROWS = 12 + kBars
var table tb = tblOn ? table.new(position.top_right, 3, ROWS, bgcolor=color.new(chart.bg_color, 5), frame_color=color.new(chart.fg_color, 75), frame_width=1, border_color=color.new(chart.fg_color, 88), border_width=1) : na
if tblOn and barstate.islast
    color TX = chart.fg_color
    color MU = color.new(chart.fg_color, 45)
    color HB = color.new(chart.fg_color, 90)
    color UP = #26A69A
    color DN = #EF5350
    tb.clear(0, 0, 2, ROWS - 1)
    string noShow = not na(tT) and e < 0 ? "the picked candle is older than the window: raise the average's N" : SLOT_ON ? "today's " + slotIn + " candle has not closed yet" : "no closed candle yet"
    f_cell(tb, 0, 0, (SLOT_ON ? "Candle at " + slotIn : "Latest closed candle") + " · " + str.tostring(timeframe.multiplier) + " min", TX, HB)
    f_cell(tb, 1, 0, show ? str.tostring(kk) + " bars: " + f_hm(hT.get(b0)) + " to " + f_hm(tT) : noShow, TX, HB)
    f_cell(tb, 2, 0, "", TX, HB)
    if show
        f_cell(tb, 0, 1, "OI-added bars", TX)
        f_cell(tb, 1, 1, str.tostring(nA) + " of " + str.tostring(nV) + " valid bars (" + str.tostring(kk - nV) + " without usable data)", MU)
        f_cell(tb, 0, 2, "Average (yardstick)", TX)
        f_cell(tb, 1, 2, na(aOI) ? "no candle added OI before the bars checked" : "ΔOI " + f_k(aOI) + " · OV " + f_p(aOV) + " · from " + str.tostring(aN) + " of the " + str.tostring(b0) + " candles before", MU)
        f_cell(tb, 0, 3, "ΔOI above avg", TX)
        f_cell(tb, 1, 3, nA > 0 and not na(aOI) ? f_of(nAO, nA) : "–", MU)
        f_cell(tb, 0, 4, "OV above avg", TX)
        f_cell(tb, 1, 4, nA > 0 and not na(aOV) ? f_of(nAV, nA) : "–", MU)
        f_cell(tb, 0, 5, "Highest ΔOI", TX)
        f_cell(tb, 1, 5, na(mxD) ? "–" : f_p(oMxD) + " of avg (" + f_k(mxD) + ") at " + f_hm(mxDT), MU)
        f_cell(tb, 0, 6, "Highest OV ratio", TX)
        f_cell(tb, 1, 6, na(mxO) ? "–" : f_p(oMxO) + " of avg (" + f_p(mxO) + ") at " + f_hm(mxOT), MU)
        f_cell(tb, 0, 7, "Rel volume (scanned candle)", TX)
        f_cell(tb, 1, 7, na(tRv) ? "unavailable: " + str.tostring(tRvN) + " earlier days at this time, " + str.tostring(rvMin) + " needed" : f_p(tRv) + " · " + str.tostring(tV, format.volume) + " vs normal " + str.tostring(tRvA, format.volume) + " (" + str.tostring(tRvN) + " days)", MU)
        string oiMiss = na(pdT) ? "no finished day loaded yet" : wPend ? "waiting for today's futures candles (they carry that day's last prints)" : "futures last prints not found for that day or the day before"
        f_cell(tb, 0, 8, "PD OI added" + (na(pdT) ? "" : " (" + str.format_time(pdT, "dd MMM", syminfo.timezone) + ")"), TX)
        f_cell(tb, 1, 8, na(pOI) ? oiMiss : f_sp(pOI) + (pdRoll ? " · contract-roll day: the shared contract only" : ""), na(pOI) ? MU : pOI > 0 ? UP : DN)
        f_cell(tb, 0, 9, "PD open to close", TX)
        f_cell(tb, 1, 9, na(pOC) ? (na(pdT) ? "no finished day loaded yet" : "the day before it is not loaded, so that day may be partial") : f_sp(pOC), na(pOC) ? MU : pOC > 0 ? UP : DN)
        string chTxt = chCd == 0 ? f_p(chSh) + " · biggest child at " + str.format_time(chT, CH_SEC < 60 ? "HH:mm:ss" : "HH:mm", syminfo.timezone) : chCd == 2 ? "the child must be shorter than the chart candle" : chCd == 3 ? "children hold " + f_p(chCov) + " of the candle's volume, not 100%" : "no child data"
        f_cell(tb, 0, 10, "Child % (" + chTf + ")", TX)
        f_cell(tb, 1, 10, chTxt, MU)
        // One row per bar checked, newest first
        f_cell(tb, 0, 11, "Bar", MU, HB)
        f_cell(tb, 1, 11, "ΔOI (% of avg)", MU, HB)
        f_cell(tb, 2, 11, "OV ratio (% of avg)", MU, HB)
        for j = 0 to kk - 1
            int   i = e - j
            float d = hD.get(i)
            float o = hO.get(i)
            bool  a = not na(d) and d > 0
            color c = na(d) ? MU : a ? UP : DN
            f_cell(tb, 0, 12 + j, f_hm(hT.get(i)) + (hG.get(i) ? " · green" : " · not green") + (hR.get(i) ? " · roll morning" : ""), MU)
            f_cell(tb, 1, 12 + j, na(d) ? f_why(hW.get(i)) : f_k(d) + (a and not na(aOI) ? " (" + f_p(f_pc(d, aOI)) + ")" : ""), c)
            f_cell(tb, 2, 12 + j, na(d) ? "–" : f_p(o) + (a and not na(aOV) ? " (" + f_p(f_pc(o, aOV)) + ")" : ""), c)
