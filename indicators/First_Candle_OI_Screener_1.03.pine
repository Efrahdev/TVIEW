//@version=6
indicator("First Candle OI Screener 1.03", "FCOI Screener", overlay=true)

// ═══════════════════════════════════════════════════════════════════════════
// FIRST CANDLE OI SCREENER 1.03 — an indicator for TradingView's Pine Screener
//   Run it on a watchlist of F&O stocks' CASH symbols (for example NSE:RELIANCE), on ANY intraday timeframe.
//   It reads the LATEST CLOSED candle of the regular day (09:15–15:30): run on 15 min at 10:31 and it reads
//   10:15–10:30; run at 09:31 and it reads the first candle. A candle that is still forming is never used.
//
//   THE CANDLE (its exact window)
//     Colour   = green or red only when its body (open to close) is at least X% of its high–low range, else 0 (thin).
//     ΔOI      = near-month (1!) OI change + next-month (2!) OI change over the candle. Futures OI only.
//     OV ratio = 100 × ΔOI ÷ (near-month volume + next-month volume) over the same candle. Never cash volume.
//     Used only when both contracts' OI candles and volume candles start exactly with the cash candle, and each
//     contract's previous OI print is the previous candle of the same day (for the day's first candle: the previous
//     trading day's last print, at or after the cash chart's last candle, since F&O trades past 15:30).
//     Anything else is unavailable, never a guess, a zero or one expiry: a missing or misaligned candle, a
//     contract-roll morning, or an OV ratio above 100% (impossible inside one window, so the data is misaligned).
//     Average  = the mean ΔOI and mean OV ratio of every candle (any time of day, green or red) that ADDED OI
//                (ΔOI > 0) in the last N candles, by the same rules, leaving out the candle being judged.
//     Child contribution = the biggest child candle's cash volume ÷ the candle's cash volume. Used only when the
//     child candles add up exactly to the candle's volume, so a missing child can never distort it.
//
//   THE PREVIOUS DAY (the trading day before the candle's day; columns only, they never change Pass)
//     PD OI added %     = (near + next OI at its close − near + next OI at the close before) ÷ that earlier OI.
//                         Each close is the contract's LAST print of the day, including F&O trading after 15:30.
//     PD open to close  = the stock's cash close ÷ cash open of that day − 1, in %.
//     PD OV ratio       = 100 × that day's near + next ΔOI ÷ that day's total near + next futures volume
//                         (every futures candle of the day, including after 15:30).
//     Unavailable on a contract-roll day (1! and 2! switch contracts), a partial day, or missing data.
//     Average of each   = the mean SIZE (ignoring sign) over the full days that start inside the last N candles,
//                         leaving out the previous day itself. "vs avg" = 100 × value ÷ that average, keeping the
//                         value's sign: +150 = 1.5 times a usual day and rising, −150 = 1.5 times and falling.
//
//   SCREENER COLUMNS (the first 10 plots, in this order)
//     Pass             1 = passes every ticked check · 0 = fails one · empty = a value it needs is missing
//     ΔOI % of avg     the candle's ΔOI as a % of its average (152 = 1.52 times)
//     OV % of avg      the same for the OV ratio
//     Child %          the biggest child candle's share of the candle's volume (empty while check 5 is off)
//     PD OI added %    the previous day's OI change, % of the OI before it
//     PD open to close % the previous day's cash open to close, %
//     PD OV vs avg     the previous day's OV ratio as a signed % of its average size
//     ΔOI              the candle's ΔOI, near + next month
//     OV ratio %       the candle's OV ratio
//     Avg count        how many candles in the window added OI and make up the average
//   Also in the data window and the chart table (not screener columns): Colour, PD OI vs avg.
//
//   No repainting: a candle is read only after it has closed, every request uses lookahead_off, and nothing comes
//   from a later candle. Pine Screener limits respected: 5 data requests (exactly 5 here), inputs it can change
//   (no timeframe or symbol inputs), and only the last 500 candles of history (see the Window setting).
// ═══════════════════════════════════════════════════════════════════════════

// ───────────────────────────────── INPUTS ─────────────────────────────────
grpC    = "Checks on the latest closed candle (untick a check to switch it off)"
bullOn  = input.bool(true, "1 · Bullish close (green)", group=grpC, display=display.none)
bearOn  = input.bool(true, "2 · Bearish close (red)", group=grpC, display=display.none, tooltip="Tick one colour to screen only that colour, tick both to accept either colour, untick both to ignore colour. A thin candle (see the next setting) is neither colour, so it fails whenever a colour is ticked.")
bodyPct = input.float(20.0, "Minimum body for green or red, % of the candle's range", minval=0.0, maxval=100.0, step=5.0, group=grpC, display=display.none, tooltip="Body = open to close. Range = high to low. A candle whose body is smaller than this % of its range is thin (directionless): Colour 0. Example: range 10, body 1.5 = 15%, thin at 20.")
oiOn    = input.bool(true, "3 · ΔOI at least", inline="oi", group=grpC, display=display.none)
oiPct   = input.float(100.0, "% of its average", minval=0.0, step=10.0, inline="oi", group=grpC, display=display.none, tooltip="The candle must ADD futures OI (near + next month), and its ΔOI must reach this % of the average ΔOI of the candles that added OI in the window: 100 = average, 152 = 1.52 times.")
ovOn    = input.bool(true, "4 · OV ratio at least", inline="ov", group=grpC, display=display.none)
ovPct   = input.float(100.0, "% of its average", minval=0.0, step=10.0, inline="ov", group=grpC, display=display.none, tooltip="The candle must ADD OI, and its OV ratio (ΔOI ÷ futures volume, near + next month) must reach this % of the average OV ratio of the candles that added OI in the window.")
chOn    = input.bool(false, "5 · Child contribution at least", inline="ch", group=grpC, display=display.none)
chPct   = input.float(50.0, "% of the candle's volume", minval=0.0, maxval=100.0, step=5.0, inline="ch", group=grpC, display=display.none, tooltip="The biggest child candle inside the candle must hold this % of the candle's cash volume. Unticked, child data is not loaded at all, so the screen runs faster.")
chTf    = input.string("1 minute", "Child candle size (for check 5)", options=["1 second", "5 seconds", "10 seconds", "15 seconds", "30 seconds", "1 minute"], group=grpC, display=display.none, tooltip="The size of the small candles inside the candle. Seconds need a Premium plan or higher, and the child must be shorter than the chart's candle.")

grpA = "Averages"
avgN = input.int(498, "Window: the last N candles", minval=10, maxval=5000, group=grpA, display=display.none, tooltip="Both averages come from this window: the candle averages from every candle in it that added OI, the previous-day averages from the full days that start in it.\nThe Pine Screener holds only 500 candles, and 498 makes the chart and the screener use exactly the same candles at any time of day. On 15 min that is about 19 days, on 5 min about 6, on 1 min about 1.")

grpD  = "Chart"
tblOn = input.bool(true, "Table of the latest closed candle", group=grpD, display=display.none, tooltip="Shown on a chart only, for checking the numbers. The screener does not use it.")

// ─────────────────────────── CHART CHECK AND CONSTANTS ───────────────────────────
if not timeframe.isminutes
    runtime.error("FCOI Screener: use an intraday timeframe from 1 minute to 4 hours.")

const string NOSYM = "NSE:FCOI_NO_SYMBOL_0"        // deliberately invalid: a request that is not needed loads nothing
const int    PD_MAX = 400                          // previous-day rows kept (far more than any window holds)
int    TF_MS    = timeframe.in_seconds() * 1000
int    CH_SEC   = chTf == "1 second" ? 1 : chTf == "5 seconds" ? 5 : chTf == "10 seconds" ? 10 : chTf == "15 seconds" ? 15 : chTf == "30 seconds" ? 30 : 60
string CH_TF    = CH_SEC < 60 ? str.tostring(CH_SEC) + "S" : "1"
bool   CH_OK    = CH_SEC * 1000 < TF_MS            // a child must be shorter than the chart candle
int    CH_BARS  = math.round(48000.0 / CH_SEC)     // child candles in two sessions of 400 minutes: covers the latest session

// ─────────────────────────────── UTILITIES ───────────────────────────────
f_at(int t, int h, int m) => timestamp(syminfo.timezone, year(t), month(t), dayofmonth(t), h, m, 0)
f_ymd(int t) => year(t) * 10000 + month(t) * 100 + dayofmonth(t)
// A futures value's previous candle belongs to the cash chart's previous candle: same date, and not earlier
f_prevOk(int prevT, float prevV, int pt) => not na(pt) and not na(prevT) and prevT >= pt and f_ymd(prevT) == f_ymd(pt) and not na(prevV)

// ─────────────────────────────── DATA REQUESTS (5) ───────────────────────────────
// Futures: near month (1!) and next month (2!) of the same stock, the chart's timeframe, gaps_on (no futures candle
// at this time = na, never a carried value), lookahead_off. Each request returns its own candle's time, so the
// alignment with the cash candle is checked, not assumed.
string EXCH = syminfo.prefix == "BSE" ? "NSE" : syminfo.prefix
string FUT1 = EXCH + ":" + syminfo.ticker + "1!"
string FUT2 = EXCH + ":" + syminfo.ticker + "2!"
f_oiReq() => [time, close, time[1], close[1]]      // this OI candle, and the one before it
f_vReq() =>                                        // this volume candle, and the running total up to the one before it
    float cum = ta.cum(nz(volume))
    [time, volume, time[1], cum[1]]
[n1T, n1C, n1PT, n1PC] = request.security(FUT1 + "_OI", timeframe.period, f_oiReq(), gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
[n2T, n2C, n2PT, n2PC] = request.security(FUT2 + "_OI", timeframe.period, f_oiReq(), gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
[v1T, v1V, v1PT, v1PQ] = request.security(FUT1, timeframe.period, f_vReq(), gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
[v2T, v2V, v2PT, v2PQ] = request.security(FUT2, timeframe.period, f_vReq(), gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
// Child candles: the stock's own cash volume, one value per child candle inside this chart candle (with its start time)
[cT, cV] = request.security_lower_tf(chOn and CH_OK ? syminfo.tickerid : NOSYM, CH_TF, [time, volume], ignore_invalid_symbol=true, ignore_invalid_timeframe=true, calc_bars_count=CH_BARS)

// ─────────────────────────────── CANDLE AND DAY ───────────────────────────────
// A candle counts only once it has closed. The time test also guards the screener's last candle while it is forming.
bool closed = barstate.isconfirmed and (barstate.isrealtime or na(timenow) or time_close <= timenow)
int  bD0    = f_at(time, 9, 15)
bool inDay  = time >= bD0 and time < f_at(time, 16, 0)     // the regular day (no evening special sessions)
bool cBar   = closed and inDay                              // a closed candle of the regular day
int  pT     = time[1]                                       // the cash chart's previous candle
var int dayKey = na
bool newDay = cBar and (na(dayKey) or bD0 != dayKey)        // the day's first closed candle

// ─────────────────────────────── THIS CANDLE'S FUTURES ───────────────────────────────
bool o1 = not na(n1T) and n1T == time and n1C > 0 and f_prevOk(n1PT, n1PC, pT) and n1PC > 0
bool o2 = not na(n2T) and n2T == time and n2C > 0 and f_prevOk(n2PT, n2PC, pT) and n2PC > 0
bool q1 = not na(v1T) and v1T == time and not na(v1V)
bool q2 = not na(v2T) and v2T == time and not na(v2V)
// Contract roll (only possible overnight): today's near month looks like yesterday's next month
bool roll = newDay and o1 and o2 and math.abs(n1C - n2PC) < math.abs(n1C - n1PC)
float cD  = na
float cO  = na
int   cCd = 1                                      // 0 valid · 1 missing or misaligned · 2 contract roll · 3 OV above 100%
if o1 and o2 and q1 and q2 and v1V + v2V > 0
    if roll
        cCd := 2
    else
        float d = (n1C - n1PC) + (n2C - n2PC)
        float o = 100.0 * d / (v1V + v2V)
        if math.abs(o) > 100.0
            cCd := 3
        else
            cCd := 0
            cD  := d
            cO  := o

// ─────────────────────────────── STATE ───────────────────────────────
// Rolling window of closed candles: ΔOI and OV ratio of the candles that added OI (na = not added or no data)
var array<float> hOI = array.new_float()
var array<float> hOV = array.new_float()
var float sOI = 0.0                        // running sums and count of the rows that are not na
var float sOV = 0.0
var int   cOI = 0
// The latest closed candle
var int   tT   = na
var int   tCol = 0                         // 1 green · -1 red · 0 thin
var float tBd  = na                        // its body, % of its range
var float tD   = na
var float tO   = na
var int   tCd  = 1
var float chSh  = na                       // child share, %
var float chCov = na                       // the children's volume ÷ the candle's volume, %
var int   chT   = na                       // the biggest child's start time
var int   chCd  = 4                        // 0 valid · 1 no child data · 2 child not shorter than the chart candle · 3 children do not add up · 4 off
// The day in progress
var int   dStBi   = na                     // its first closed candle's bar_index
var bool  dSt915  = false                  // it started at 09:15
var float dOpen   = na
var float dClose  = na
var int   dLastT  = na                     // its latest closed candle's open time
var float dOI0    = na                     // near + next OI at the previous day's close (na = not valid)
var bool  dNoRoll = false                  // its first candle's OI is valid and shows no contract roll
var float dQ0     = na                     // near + next running futures volume up to the previous day's close
// One row per finished day, oldest first
var array<int>   pdBi = array.new_int()    // the day's first candle's bar_index
var array<int>   pdT  = array.new_int()    // the day's 09:15
var array<float> pdOI = array.new_float()  // OI added, %
var array<float> pdOC = array.new_float()  // cash open to close, %
var array<float> pdOV = array.new_float()  // OV ratio, %

// ─────────────────────────────── A NEW DAY: finish the previous one ───────────────────────────────
if newDay
    // The previous day's closing values, read from each futures series' last candle before today's first candle
    bool  pEnd = not na(pT) and pT + TF_MS >= f_at(pT, 15, 30)          // the cash chart's previous candle reached 15:30
    float oiE  = pEnd and f_prevOk(n1PT, n1PC, pT) and n1PC > 0 and f_prevOk(n2PT, n2PC, pT) and n2PC > 0 ? n1PC + n2PC : na
    float qE   = pEnd and f_prevOk(v1PT, v1PQ, pT) and f_prevOk(v2PT, v2PQ, pT) ? v1PQ + v2PQ : na
    if not na(dStBi)
        float rOI = na
        float rOC = na
        float rOV = na
        if not na(dOI0) and dNoRoll and not na(oiE)
            float dd = oiE - dOI0
            rOI := 100.0 * dd / dOI0
            if not na(dQ0) and not na(qE) and qE - dQ0 > 0
                float ov = 100.0 * dd / (qE - dQ0)
                rOV := math.abs(ov) <= 100.0 ? ov : na
        if dSt915 and pEnd and dLastT == pT and dOpen > 0
            rOC := 100.0 * (dClose - dOpen) / dOpen
        pdBi.push(dStBi)
        pdT.push(dayKey)
        pdOI.push(rOI)
        pdOC.push(rOC)
        pdOV.push(rOV)
        if pdBi.size() > PD_MAX
            pdBi.shift()
            pdT.shift()
            pdOI.shift()
            pdOC.shift()
            pdOV.shift()
    // Start the new day
    dayKey  := bD0
    dStBi   := bar_index
    dSt915  := time == bD0
    dOpen   := open
    dOI0    := oiE
    dQ0     := qE
    dNoRoll := o1 and o2 and not roll

// ─────────────────────────────── EVERY CLOSED CANDLE ───────────────────────────────
if cBar
    // The day's latest close
    dClose := close
    dLastT := time
    // Into the rolling window
    float rD = cCd == 0 and cD > 0 ? cD : na
    float rO = cCd == 0 and cD > 0 ? cO : na
    hOI.push(rD)
    hOV.push(rO)
    if not na(rD)
        sOI += rD
        sOV += rO
        cOI += 1
    while hOI.size() > avgN
        float xD = hOI.shift()
        float xO = hOV.shift()
        if not na(xD)
            sOI -= xD
            sOV -= xO
            cOI -= 1
    // It becomes the latest closed candle
    float rng = high - low
    tT   := time
    tBd  := rng > 0 ? 100.0 * math.abs(close - open) / rng : na
    tCol := rng > 0 and math.abs(close - open) * 100.0 >= bodyPct * rng ? (close > open ? 1 : close < open ? -1 : 0) : 0
    tD   := cD
    tO   := cO
    tCd  := cCd
    // Child contribution: exact only, so the child candles must add up to the candle's own volume.
    // Worked out only for the last two candles, because only the latest closed candle is ever shown.
    chSh  := na
    chCov := na
    chT   := na
    chCd  := chOn ? 1 : 4
    if chOn and bar_index >= last_bar_index - 1
        if not CH_OK
            chCd := 2
        else if not na(cV) and not na(cT) and cV.size() > 0 and volume > 0
            float s  = 0.0
            float b  = -1.0
            int   bt = na
            for i = 0 to cV.size() - 1
                float v = nz(cV.get(i))
                s += v
                if v > b
                    b  := v
                    bt := cT.get(i)
            chCov := 100.0 * s / volume
            chT   := bt
            if math.abs(s - volume) < 0.5
                chSh := 100.0 * b / volume
                chCd := 0
            else
                chCd := 3

// ─────────────────────────────── AVERAGES ───────────────────────────────
// The candle's averages: every candle that added OI in the window, leaving out the candle being judged
bool  tIn  = tCd == 0 and tD > 0
int   refN = cOI - (tIn ? 1 : 0)
float refOI = refN > 0 ? (sOI - (tIn ? tD : 0.0)) / refN : na
float refOV = refN > 0 ? (sOV - (tIn ? tO : 0.0)) / refN : na
// The previous day = the newest finished day. Its averages: the full days that start inside the window, leaving it out.
int   pdN  = pdBi.size()
float pOI  = pdN > 0 ? pdOI.last() : na
float pOC  = pdN > 0 ? pdOC.last() : na
float pOV  = pdN > 0 ? pdOV.last() : na
float aOI  = na
float aOC  = na
float aOV  = na
int   nOI  = 0
int   nOC  = 0
int   nOV  = 0
if barstate.islast and pdN > 1
    int   lo  = bar_index - avgN + 1
    float zOI = 0.0
    float zOC = 0.0
    float zOV = 0.0
    for i = 0 to pdN - 2
        if pdBi.get(i) >= lo
            float x1 = pdOI.get(i)
            float x2 = pdOC.get(i)
            float x3 = pdOV.get(i)
            if not na(x1)
                zOI += math.abs(x1)
                nOI += 1
            if not na(x2)
                zOC += math.abs(x2)
                nOC += 1
            if not na(x3)
                zOV += math.abs(x3)
                nOV += 1
    aOI := nOI > 0 ? zOI / nOI : na
    aOC := nOC > 0 ? zOC / nOC : na
    aOV := nOV > 0 ? zOV / nOV : na
f_vs(float v, float a) => na(v) or na(a) or a <= 0 ? na : 100.0 * v / a

// ─────────────────────────────── THE FIVE CHECKS ───────────────────────────────
// Each check: 1 passes · 0 fails · -1 a value it needs is missing. A check that is off passes.
bool show = not na(tT)
int  kCol = bullOn and bearOn ? (tCol != 0 ? 1 : 0) : bullOn ? (tCol == 1 ? 1 : 0) : bearOn ? (tCol == -1 ? 1 : 0) : 1
int  kOI  = not oiOn ? 1 : na(tD) ? -1 : tD <= 0 ? 0 : na(refOI) ? -1 : tD * 100.0 >= oiPct * refOI ? 1 : 0
int  kOV  = not ovOn ? 1 : na(tO) ? -1 : tO <= 0 ? 0 : na(refOV) ? -1 : tO * 100.0 >= ovPct * refOV ? 1 : 0
int  kCh  = not chOn ? 1 : na(chSh) ? -1 : chSh >= chPct ? 1 : 0
int  kAll = kCol == 0 or kOI == 0 or kOV == 0 or kCh == 0 ? 0 : kOI == -1 or kOV == -1 or kCh == -1 ? -1 : 1
int  code = not show ? 1 : (oiOn or ovOn) and tCd != 0 ? 3 : (oiOn or ovOn) and na(refOI) ? 4 : chOn and chCd != 0 ? 5 : 0

// ─────────────────────────────── SCREENER COLUMNS (the first 10 plots) ───────────────────────────────
// Not drawn on the chart: the values appear in the Pine Screener and in the chart's data window.
float oPass = show and kAll >= 0 ? kAll : na
float oOIp  = show and not na(tD) and not na(refOI) and refOI > 0 ? 100.0 * tD / refOI : na
float oOVp  = show and not na(tO) and not na(refOV) and refOV > 0 ? 100.0 * tO / refOV : na
float oCh   = show ? chSh : na
float oPOI  = show ? pOI : na
float oPOC  = show ? pOC : na
float oPOVv = show ? f_vs(pOV, aOV) : na
float oDoi  = show ? tD : na
float oOv   = show ? tO : na
float oN    = show ? refN : na
float oCol  = show ? tCol : na
float oPOIv = show ? f_vs(pOI, aOI) : na
plot(oPass, "Pass", #2962FF, display=display.all - display.pane - display.price_scale - display.status_line, precision=0)
plot(oOIp, "ΔOI % of avg", #26A69A, display=display.all - display.pane - display.price_scale - display.status_line, precision=1)
plot(oOVp, "OV % of avg", #26A69A, display=display.all - display.pane - display.price_scale - display.status_line, precision=1)
plot(oCh, "Child %", #00ACC1, display=display.all - display.pane - display.price_scale - display.status_line, precision=1)
plot(oPOI, "PD OI added %", #9C27B0, display=display.all - display.pane - display.price_scale - display.status_line, precision=2)
plot(oPOC, "PD open to close %", #9C27B0, display=display.all - display.pane - display.price_scale - display.status_line, precision=2)
plot(oPOVv, "PD OV vs avg", #9C27B0, display=display.all - display.pane - display.price_scale - display.status_line, precision=1)
plot(oDoi, "ΔOI", #787B86, display=display.all - display.pane - display.price_scale - display.status_line, format=format.volume)
plot(oOv, "OV ratio %", #787B86, display=display.all - display.pane - display.price_scale - display.status_line, precision=2)
plot(oN, "Avg count", #787B86, display=display.all - display.pane - display.price_scale - display.status_line, precision=0)
// Data window only (after the first 10, so not screener columns)
plot(oCol, "Colour", #787B86, display=display.data_window, precision=0)
plot(oPOIv, "PD OI vs avg", #787B86, display=display.data_window, precision=1)

// ─────────────────────────────── TABLE (chart only) ───────────────────────────────
f_cell(table t, int c, int r, string s, color tc, color bg = na) =>
    table.cell(t, c, r, s, text_color=tc, bgcolor=bg, text_size=size.small, text_halign=c == 2 ? text.align_center : text.align_left)
f_k(float v) => na(v) ? "–" : (v > 0 ? "+" : "") + str.tostring(v, format.volume)
f_p(float x) => na(x) ? "–" : str.tostring(x, "0.0") + "%"
f_sp(float x) => na(x) ? "–" : (x > 0 ? "+" : "") + str.tostring(x, "0.00") + "%"
f_ok(int k, bool isOn) => not isOn ? "off" : k == 1 ? "✓" : k == 0 ? "✗" : "?"
// "150% of avg (+3.00%)" · avg size and how many days it is made of
f_pd(float v, float a, int n) => na(v) ? "unavailable (roll day, partial day or missing data)" : (na(a) ? "no average yet" : str.tostring(f_vs(v, a), "0") + "% of avg") + " (" + f_sp(v) + ") · avg " + f_p(a) + " of " + str.tostring(n) + " days"

var table tb = tblOn ? table.new(position.top_right, 3, 11, bgcolor=color.new(chart.bg_color, 5), frame_color=color.new(chart.fg_color, 75), frame_width=1, border_color=color.new(chart.fg_color, 88), border_width=1) : na
if tblOn and barstate.islast
    color TX = chart.fg_color
    color MU = color.new(chart.fg_color, 45)
    color HB = color.new(chart.fg_color, 90)
    color UP = #26A69A
    color DN = #EF5350
    string res  = not show ? "WAITING" : kAll == 1 ? "PASS" : kAll == 0 ? "FAIL" : "DATA MISSING"
    color  resC = show and kAll == 1 ? (tCol == -1 ? DN : UP) : MU
    f_cell(tb, 0, 0, "Latest closed candle · " + str.tostring(timeframe.multiplier) + " min", TX, HB)
    f_cell(tb, 1, 0, show ? str.format_time(tT, "dd MMM yyyy HH:mm", syminfo.timezone) + "–" + str.format_time(math.min(tT + TF_MS, f_at(tT, 15, 30)), "HH:mm", syminfo.timezone) : "no closed candle yet", TX, HB)
    f_cell(tb, 2, 0, res, resC, HB)

    string colRule = bullOn and bearOn ? "green or red" : bullOn ? "green" : bearOn ? "red" : "any"
    f_cell(tb, 0, 1, "1·2 · Colour: " + colRule + " (body ≥ " + str.tostring(bodyPct) + "%)", TX)
    f_cell(tb, 1, 1, show ? (tCol == 1 ? "Green" : tCol == -1 ? "Red" : "Thin") + " · body " + f_p(tBd) + " of range" : "–", show and tCol == 1 ? UP : show and tCol == -1 ? DN : MU)
    f_cell(tb, 2, 1, show ? f_ok(kCol, bullOn or bearOn) : "–", TX)

    f_cell(tb, 0, 2, "3 · ΔOI ≥ " + str.tostring(oiPct) + "% of avg", oiOn ? TX : MU)
    f_cell(tb, 1, 2, show ? f_k(tD) + " · " + f_p(oOIp) + " of avg " + f_k(refOI) : "–", MU)
    f_cell(tb, 2, 2, show ? f_ok(kOI, oiOn) : "–", TX)

    f_cell(tb, 0, 3, "4 · OV ratio ≥ " + str.tostring(ovPct) + "% of avg", ovOn ? TX : MU)
    f_cell(tb, 1, 3, show ? f_p(tO) + " · " + f_p(oOVp) + " of avg " + f_p(refOV) : "–", MU)
    f_cell(tb, 2, 3, show ? f_ok(kOV, ovOn) : "–", TX)

    string chTxt = not chOn ? "not loaded (check 5 is off)" : chCd == 0 ? f_p(chSh) + " · biggest child at " + str.format_time(chT, CH_SEC < 60 ? "HH:mm:ss" : "HH:mm", syminfo.timezone) : chCd == 2 ? "the child must be shorter than the chart candle" : chCd == 3 ? "children hold " + f_p(chCov) + " of the candle's volume, not 100%" : "no child data"
    f_cell(tb, 0, 4, "5 · Child ≥ " + str.tostring(chPct) + "% (" + chTf + ")", chOn ? TX : MU)
    f_cell(tb, 1, 4, show ? chTxt : "–", MU)
    f_cell(tb, 2, 4, show ? f_ok(kCh, chOn) : "–", TX)

    f_cell(tb, 0, 5, "Candle average", MU)
    f_cell(tb, 1, 5, str.tostring(refN) + " of the last " + str.tostring(hOI.size()) + " candles added OI", MU)
    f_cell(tb, 2, 5, "", MU)

    f_cell(tb, 0, 6, "Previous day", TX, HB)
    f_cell(tb, 1, 6, pdN > 0 ? str.format_time(pdT.last(), "dd MMM yyyy", syminfo.timezone) : "not loaded yet", TX, HB)
    f_cell(tb, 2, 6, "", TX, HB)

    f_cell(tb, 0, 7, "PD OI added", TX)
    f_cell(tb, 1, 7, pdN > 0 ? f_pd(pOI, aOI, nOI) : "–", MU)
    f_cell(tb, 2, 7, "", MU)

    f_cell(tb, 0, 8, "PD open to close", TX)
    f_cell(tb, 1, 8, pdN > 0 ? f_pd(pOC, aOC, nOC) : "–", MU)
    f_cell(tb, 2, 8, "", MU)

    f_cell(tb, 0, 9, "PD OV ratio", TX)
    f_cell(tb, 1, 9, pdN > 0 ? f_pd(pOV, aOV, nOV) : "–", MU)
    f_cell(tb, 2, 9, "", MU)

    string why = code == 0 ? "all data present for the ticked checks" : code == 1 ? "no closed candle of the regular day yet" : code == 3 ? (tCd == 2 ? "contract-roll morning: 1! and 2! switched contracts" : tCd == 3 ? "OV ratio above 100%: OI and volume are not from the same window" : "futures OI or volume missing, or not stamped to this candle") : code == 4 ? "no candle that added OI in the window yet" : chTxt
    f_cell(tb, 0, 10, "Data", MU)
    f_cell(tb, 1, 10, why + " · " + FUT1 + " + " + FUT2, MU)
    f_cell(tb, 2, 10, "", MU)
