//@version=6
indicator("First Candle OI Screener 1.02", "FCOI Screener", overlay=true)

// ═══════════════════════════════════════════════════════════════════════════
// FIRST CANDLE OI SCREENER 1.02 — an indicator for TradingView's Pine Screener
//   Run it on a watchlist of F&O stocks' CASH symbols (for example NSE:RELIANCE), on ANY intraday timeframe.
//   First candle = the session's first chart candle, from 09:15: 09:15–09:20 on 5 min, 09:15–09:30 on 15 min.
//   Every value belongs to the latest session's first candle and stays fixed for the day once that candle closes.
//
//   DATA (the first candle's exact window)
//     ΔOI      = near-month (1!) OI change + next-month (2!) OI change over the first candle. Futures OI only.
//                Each contract's change is measured from its own last OI print of the previous trading day.
//     OV ratio = 100 × ΔOI ÷ (near-month volume + next-month volume) over the same candle. Never cash volume.
//     Used only when both contracts' OI candles and volume candles are stamped 09:15 today, and both previous
//     OI prints come from the previous trading day, no earlier than the cash chart's last candle of that day
//     (F&O trades to 15:40 since 3 Aug 2026 and to 15:45 from 7 Dec 2026; the cash chart stops at 15:30).
//     Anything else is unavailable, never a guess, a zero or one expiry: a missing or misaligned candle, a
//     contract-roll morning, or an OV ratio above 100% (impossible inside one window, so the data is misaligned).
//     Average  = the mean ΔOI and mean OV ratio of EVERY candle (any time of day, green or red) that ADDED OI
//                (ΔOI > 0) in the last 499 candles, measured with the same rules. Today's first candle is left out
//                of its own average. The chart and the Pine Screener (500 candles) cover the same 499 candles.
//     Child contribution = the biggest child candle's cash volume ÷ the first candle's cash volume. Used only when
//     the child candles add up exactly to the first candle's volume, so a missing child can never distort it.
//     Previous day's VWAP = the stock's own VWAP of the last full session, from the chart's candles.
//
//   CHECKS (each one on / off): 1 bullish close · 2 bearish close · 3 ΔOI ≥ X% of its average · 4 OV ratio ≥ Y%
//     of its average · 5 child contribution ≥ Z% · 6 close above the previous day's VWAP (a red first candle: below).
//
//   SCREENER COLUMNS (the first 10 plots, in this order)
//     Pass           1 = passes every ticked check · 0 = fails one · empty = a value it needs is missing (see Data)
//     Colour         1 green · −1 red · 0 doji
//     ΔOI % of avg   the first candle's ΔOI as a % of its average (152 = 1.52 times)
//     OV % of avg    the same for the OV ratio
//     Child %        the biggest child candle's share of the first candle's volume (empty while check 5 is off)
//     vs PD VWAP %   how far the compared close is from the previous day's VWAP (above = positive)
//     ΔOI            the first candle's ΔOI, near + next month
//     OV ratio %     the first candle's OV ratio
//     Avg count      how many candles (of the last 499) added OI and make up the average
//     Data           0 all data present for the ticked checks · 1 first candle not closed yet · 2 no 09:15 candle
//                    · 3 futures data unavailable · 4 average not ready · 5 child data incomplete · 6 no previous-day VWAP
//
//   No repainting: a candle is read only after it has closed, every request uses lookahead_off, and nothing comes
//   from a later candle. Pine Screener limits respected: 5 data requests (exactly 5 here), inputs it can change
//   (no timeframe or symbol inputs), and only the last 500 candles of history (see the Average setting).
// ═══════════════════════════════════════════════════════════════════════════

// ───────────────────────────────── INPUTS ─────────────────────────────────
grpC   = "Checks on the first candle (untick a check to switch it off)"
bullOn = input.bool(true, "1 · Bullish close (green: close above open)", group=grpC, display=display.none)
bearOn = input.bool(true, "2 · Bearish close (red: close below open)", group=grpC, display=display.none, tooltip="Tick one colour to screen only that colour, tick both to accept either colour, untick both to ignore colour.")
oiOn   = input.bool(true, "3 · ΔOI at least", inline="oi", group=grpC, display=display.none)
oiPct  = input.float(100.0, "% of its average", minval=0.0, step=10.0, inline="oi", group=grpC, display=display.none, tooltip="The first candle must ADD futures OI (near + next month), and its ΔOI must reach this % of the average first candle's ΔOI: 100 = average, 152 = 1.52 times.")
ovOn   = input.bool(true, "4 · OV ratio at least", inline="ov", group=grpC, display=display.none)
ovPct  = input.float(100.0, "% of its average", minval=0.0, step=10.0, inline="ov", group=grpC, display=display.none, tooltip="The first candle must ADD OI, and its OV ratio (ΔOI ÷ futures volume, near + next month) must reach this % of the average first candle's OV ratio.")
chOn   = input.bool(false, "5 · Child contribution at least", inline="ch", group=grpC, display=display.none)
chPct  = input.float(50.0, "% of the candle's volume", minval=0.0, maxval=100.0, step=5.0, inline="ch", group=grpC, display=display.none, tooltip="The biggest child candle inside the first candle must hold this % of the first candle's cash volume. Unticked, child data is not loaded at all, so the screen runs faster.")
chTf   = input.string("1 minute", "Child candle size (for check 5)", options=["1 second", "5 seconds", "10 seconds", "15 seconds", "30 seconds", "1 minute"], group=grpC, display=display.none, tooltip="The size of the small candles inside the first candle. Seconds need a Premium plan or higher, and the child must be shorter than the chart's candle.")
pdOn   = input.bool(true, "6 · Previous day's VWAP: green above it, red below it", group=grpC, display=display.none, tooltip="A green first candle (or a doji) must close above yesterday's VWAP, a red one below it.")
pdAt   = input.string("First candle's close", "Price compared with the VWAP (for check 6)", options=["First candle's close", "Latest closed candle"], group=grpC, display=display.none, tooltip="First candle's close: fixed for the day once the first candle closes.\nLatest closed candle: the close of the newest closed candle, so the result can change during the day. Green or red still means the first candle's colour.")

grpA = "Average"
avgN = input.int(499, "Average of every candle that added OI, in the last N candles", minval=10, maxval=5000, group=grpA, display=display.none, tooltip="Every candle (any time of day) whose near + next month OI rose is averaged, and the first candle is compared with that average. The Pine Screener holds 500 candles, so 499 makes the chart and the screener match. Avg count shows how many candles added OI.")

grpD  = "Chart"
tblOn = input.bool(true, "Table of the latest first candle", group=grpD, display=display.none, tooltip="Shown on a chart only, for checking the numbers. The screener does not use it.")

// ─────────────────────────── CHART CHECK AND CONSTANTS ───────────────────────────
if not timeframe.isminutes
    runtime.error("FCOI Screener: use an intraday timeframe from 1 minute to 4 hours.")

const string NOSYM = "NSE:FCOI_NO_SYMBOL_0"        // deliberately invalid: a request that is not needed loads nothing
int    TF_SEC   = timeframe.in_seconds()
int    CH_SEC   = chTf == "1 second" ? 1 : chTf == "5 seconds" ? 5 : chTf == "10 seconds" ? 10 : chTf == "15 seconds" ? 15 : chTf == "30 seconds" ? 30 : 60
string CH_TF    = CH_SEC < 60 ? str.tostring(CH_SEC) + "S" : "1"
bool   CH_OK    = CH_SEC < TF_SEC                  // a child must be shorter than the chart candle
int    CH_BARS  = math.round(48000.0 / CH_SEC)     // child candles in two sessions of 400 minutes: covers the latest session
bool   FUT_ON   = oiOn or ovOn                     // futures data is loaded only when check 3 or 4 is on
bool   PD_FIRST = pdAt == "First candle's close"

// ─────────────────────────────── UTILITIES ───────────────────────────────
f_at(int t, int h, int m) => timestamp(syminfo.timezone, year(t), month(t), dayofmonth(t), h, m, 0)
f_ymd(int t) => year(t) * 10000 + month(t) * 100 + dayofmonth(t)
f_mean(array<float> a) =>                          // [mean of the values that are not na, how many]
    float s = 0.0
    int   n = 0
    for x in a
        if not na(x)
            s += x
            n += 1
    [n > 0 ? s / n : na, n]

// ─────────────────────────────── DATA REQUESTS (5) ───────────────────────────────
// Futures: near month (1!) and next month (2!) of the same stock, the chart's timeframe, gaps_on (no futures candle
// at this time = na, never a carried value), lookahead_off. Each request returns its own candle's time, so the
// alignment with the cash candle is checked, not assumed.
string EXCH = syminfo.prefix == "BSE" ? "NSE" : syminfo.prefix
string FUT1 = EXCH + ":" + syminfo.ticker + "1!"
string FUT2 = EXCH + ":" + syminfo.ticker + "2!"
f_oiReq() => [time, close, time[1], close[1]]      // this OI candle and the one before it
f_vReq()  => [time, volume]
[n1T, n1C, n1PT, n1PC] = request.security(FUT_ON ? FUT1 + "_OI" : NOSYM, timeframe.period, f_oiReq(), gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
[n2T, n2C, n2PT, n2PC] = request.security(FUT_ON ? FUT2 + "_OI" : NOSYM, timeframe.period, f_oiReq(), gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
[v1T, v1V] = request.security(FUT_ON ? FUT1 : NOSYM, timeframe.period, f_vReq(), gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
[v2T, v2V] = request.security(FUT_ON ? FUT2 : NOSYM, timeframe.period, f_vReq(), gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
// Child candles: the stock's own cash volume, one value per child candle inside this chart candle (with its start time)
[cT, cV] = request.security_lower_tf(chOn and CH_OK ? syminfo.tickerid : NOSYM, CH_TF, [time, volume], ignore_invalid_symbol=true, ignore_invalid_timeframe=true, calc_bars_count=CH_BARS)

// ─────────────────────────────── DAY ───────────────────────────────
// A candle counts only once it has closed. The time test also guards the screener's last candle while it is forming.
bool closed = barstate.isconfirmed and (barstate.isrealtime or na(timenow) or time_close <= timenow)
int  bD0    = f_at(time, 9, 15)
bool inDay  = time >= bD0 and time < f_at(time, 16, 0)     // the regular day (no evening special sessions)
int  pT     = time[1]
var int dayKey = na
bool isNew  = inDay and (na(dayKey) or bD0 != dayKey)
bool newDay = isNew and closed                              // the session's first closed candle
bool waitFc = isNew and not closed                          // the session's first candle is still forming

// ─────────────────────────────── STATE ───────────────────────────────
var array<float> hOI = array.new_float()   // every closed candle's ΔOI, oldest first (na = OI not added or no data)
var array<float> hOV = array.new_float()   // its OV ratio, same rows
var float sOI = 0.0                        // running sums and count of the rows that are not na
var float sOV = 0.0
var int   cOI = 0
var int   fcBi = na                        // today's first candle's bar_index
var bool  rec    = false                   // true from the first session that starts at 09:15 (a partial first day is never used)
var float vwPV   = 0.0                     // this session's VWAP sums
var float vwV    = 0.0
var float pdVw   = na                      // the previous session's VWAP
var float lastCl = na                      // this session's latest closed candle's close
// The latest session's first candle
var bool  at915  = false                   // its first closed candle starts at 09:15
var int   fcT    = na
var int   fcCol  = 0                       // 1 green · -1 red · 0 doji
var float fcCl   = na
var float fcDoi  = na
var float fcOv   = na
var int   futCd  = 4                       // 0 valid · 1 missing or misaligned · 2 contract roll · 3 OV above 100% · 4 not loaded
var float refOI  = na
var float refOV  = na
var int   refN   = 0                       // candles in the average
var int   refS   = 0                       // candles looked at
var float chSh   = na                      // child share, %
var float chCov  = na                      // the children's volume ÷ the candle's volume, %
var int   chT    = na                      // the biggest child's start time
var int   chCd   = 4                       // 0 valid · 1 no child data · 2 child not shorter than the chart candle · 3 children do not add up · 4 off

// ─────────────────────────────── NEW SESSION: read its first candle ───────────────────────────────
if newDay
    dayKey := bD0
    // Close the previous session's books
    if rec
        pdVw := vwV > 0 ? vwPV / vwV : na
    vwPV := 0.0
    vwV  := 0.0
    rec  := rec or time == bD0
    // The first candle
    at915 := time == bD0
    fcT   := time
    fcCol := close > open ? 1 : close < open ? -1 : 0
    fcCl  := close
    fcDoi := na
    fcOv  := na
    futCd := FUT_ON ? 1 : 4
    if FUT_ON and at915
        // Each contract: OI candle stamped with this cash candle, previous OI print from the previous trading day
        bool n1Ok = not na(pT) and not na(n1T) and n1T == time and not na(n1C) and n1C > 0 and not na(n1PT) and n1PT >= pT and f_ymd(n1PT) == f_ymd(pT) and not na(n1PC) and n1PC > 0
        bool n2Ok = not na(pT) and not na(n2T) and n2T == time and not na(n2C) and n2C > 0 and not na(n2PT) and n2PT >= pT and f_ymd(n2PT) == f_ymd(pT) and not na(n2PC) and n2PC > 0
        bool v1Ok = not na(v1T) and v1T == time and not na(v1V)
        bool v2Ok = not na(v2T) and v2T == time and not na(v2V)
        if n1Ok and n2Ok and v1Ok and v2Ok and v1V + v2V > 0
            // Contract roll: today's near month looks like yesterday's next month, so 1! and 2! switched contracts
            if math.abs(n1C - n2PC) < math.abs(n1C - n1PC)
                futCd := 2
            else
                float d = (n1C - n1PC) + (n2C - n2PC)
                float o = 100.0 * d / (v1V + v2V)
                if math.abs(o) > 100.0
                    futCd := 3
                else
                    futCd := 0
                    fcDoi := d
                    fcOv  := o
    // Child contribution: exact only, so the child candles must add up to the first candle's own volume
    chSh  := na
    chCov := na
    chT   := na
    chCd  := chOn ? 1 : 4
    if chOn and at915
        if not CH_OK
            chCd := 2
        else if not na(cV) and not na(cT) and cV.size() > 0 and volume > 0
            float s  = 0.0
            float b  = -1.0
            int   bt = na
            for i = 0 to cV.size() - 1
                float v = nz(cV.get(i))
                s += v
                if v > b
                    b  := v
                    bt := cT.get(i)
            chCov := 100.0 * s / volume
            chT   := bt
            if math.abs(s - volume) < 0.5
                chSh := 100.0 * b / volume
                chCd := 0
            else
                chCd := 3
    fcBi := bar_index

// Every closed candle: its ΔOI and OV ratio, by the same rules as the first candle, into the rolling average
if closed and inDay and FUT_ON
    float bD = na
    float bO = na
    if not na(pT)
        bool a1 = not na(n1T) and n1T == time and n1C > 0 and not na(n1PT) and n1PT >= pT and f_ymd(n1PT) == f_ymd(pT) and n1PC > 0
        bool a2 = not na(n2T) and n2T == time and n2C > 0 and not na(n2PT) and n2PT >= pT and f_ymd(n2PT) == f_ymd(pT) and n2PC > 0
        bool b1 = not na(v1T) and v1T == time and not na(v1V)
        bool b2 = not na(v2T) and v2T == time and not na(v2V)
        if a1 and a2 and b1 and b2 and v1V + v2V > 0 and math.abs(n1C - n2PC) >= math.abs(n1C - n1PC)
            float d = (n1C - n1PC) + (n2C - n2PC)
            float o = 100.0 * d / (v1V + v2V)
            if math.abs(o) <= 100.0 and d > 0
                bD := d
                bO := o
    hOI.push(bD)
    hOV.push(bO)
    if not na(bD)
        sOI += bD
        sOV += bO
        cOI += 1
    while hOI.size() > avgN
        float xD = hOI.shift()
        float xO = hOV.shift()
        if not na(xD)
            sOI -= xD
            sOV -= xO
            cOI -= 1

// The average now: every candle that added OI in the window, leaving out today's first candle
bool  fcIn = not na(fcBi) and futCd == 0 and fcDoi > 0 and bar_index - fcBi < hOI.size()
int   nAvg = cOI - (fcIn ? 1 : 0)
refOI := nAvg > 0 ? (sOI - (fcIn ? fcDoi : 0.0)) / nAvg : na
refOV := nAvg > 0 ? (sOV - (fcIn ? fcOv : 0.0)) / nAvg : na
refN  := nAvg
refS  := hOI.size()

// Every closed candle of the day: the latest close, and the VWAP sums (used tomorrow)
if closed and inDay
    lastCl := close
    if rec and volume > 0
        vwPV += hlc3 * volume
        vwV  += volume

// ─────────────────────────────── THE SIX CHECKS ───────────────────────────────
// Each check: 1 passes · 0 fails · -1 a value it needs is missing. A check that is off passes.
bool  show = not waitFc and not na(dayKey) and at915
float px   = PD_FIRST ? fcCl : lastCl
int   kCol = bullOn and bearOn ? (fcCol != 0 ? 1 : 0) : bullOn ? (fcCol == 1 ? 1 : 0) : bearOn ? (fcCol == -1 ? 1 : 0) : 1
int   kOI  = not oiOn ? 1 : na(fcDoi) ? -1 : fcDoi <= 0 ? 0 : na(refOI) ? -1 : fcDoi * 100.0 >= oiPct * refOI ? 1 : 0
int   kOV  = not ovOn ? 1 : na(fcOv) ? -1 : fcOv <= 0 ? 0 : na(refOV) ? -1 : fcOv * 100.0 >= ovPct * refOV ? 1 : 0
int   kCh  = not chOn ? 1 : na(chSh) ? -1 : chSh >= chPct ? 1 : 0
int   kPd  = not pdOn ? 1 : na(pdVw) or na(px) ? -1 : (fcCol == -1 ? px < pdVw : px > pdVw) ? 1 : 0
int   kAll = kCol == 0 or kOI == 0 or kOV == 0 or kCh == 0 or kPd == 0 ? 0 : kOI == -1 or kOV == -1 or kCh == -1 or kPd == -1 ? -1 : 1
int   code = waitFc or na(dayKey) ? 1 : not at915 ? 2 : FUT_ON and futCd != 0 ? 3 : FUT_ON and na(refOI) ? 4 : chOn and chCd != 0 ? 5 : pdOn and na(pdVw) ? 6 : 0

// ─────────────────────────────── SCREENER COLUMNS (the first 10 plots) ───────────────────────────────
// Not drawn on the chart: the values appear in the Pine Screener and in the chart's data window.
float oPass = show and kAll >= 0 ? kAll : na
float oCol  = show ? fcCol : na
float oOIp  = show and not na(fcDoi) and not na(refOI) and refOI > 0 ? 100.0 * fcDoi / refOI : na
float oOVp  = show and not na(fcOv) and not na(refOV) and refOV > 0 ? 100.0 * fcOv / refOV : na
float oCh   = show ? chSh : na
float oPd   = show and not na(px) and not na(pdVw) and pdVw > 0 ? 100.0 * (px - pdVw) / pdVw : na
float oDoi  = show ? fcDoi : na
float oOv   = show ? fcOv : na
float oN    = show and FUT_ON ? refN : na
plot(oPass, "Pass", #2962FF, display=display.all - display.pane - display.price_scale - display.status_line, precision=0)
plot(oCol, "Colour", #787B86, display=display.all - display.pane - display.price_scale - display.status_line, precision=0)
plot(oOIp, "ΔOI % of avg", #26A69A, display=display.all - display.pane - display.price_scale - display.status_line, precision=1)
plot(oOVp, "OV % of avg", #26A69A, display=display.all - display.pane - display.price_scale - display.status_line, precision=1)
plot(oCh, "Child %", #00ACC1, display=display.all - display.pane - display.price_scale - display.status_line, precision=1)
plot(oPd, "vs PD VWAP %", #9C27B0, display=display.all - display.pane - display.price_scale - display.status_line, precision=2)
plot(oDoi, "ΔOI", #787B86, display=display.all - display.pane - display.price_scale - display.status_line, format=format.volume)
plot(oOv, "OV ratio %", #787B86, display=display.all - display.pane - display.price_scale - display.status_line, precision=2)
plot(oN, "Avg count", #787B86, display=display.all - display.pane - display.price_scale - display.status_line, precision=0)
plot(code, "Data (0 = OK)", #787B86, display=display.all - display.pane - display.price_scale - display.status_line, precision=0)

// ─────────────────────────────── TABLE (chart only) ───────────────────────────────
f_cell(table t, int c, int r, string s, color tc, color bg = na) =>
    table.cell(t, c, r, s, text_color=tc, bgcolor=bg, text_size=size.small, text_halign=c == 2 ? text.align_center : text.align_left)
f_k(float v) => na(v) ? "–" : (v > 0 ? "+" : "") + str.tostring(v, format.volume)
f_p(float x) => na(x) ? "–" : str.tostring(x, "0.0") + "%"
f_sp(float x) => na(x) ? "–" : (x > 0 ? "+" : "") + str.tostring(x, "0.00") + "%"
f_px(float x) => na(x) ? "–" : str.tostring(x, format.mintick)
f_ok(int k, bool isOn) => not isOn ? "off" : k == 1 ? "✓" : k == 0 ? "✗" : "?"

var table tb = tblOn ? table.new(position.top_right, 3, 8, bgcolor=color.new(chart.bg_color, 5), frame_color=color.new(chart.fg_color, 75), frame_width=1, border_color=color.new(chart.fg_color, 88), border_width=1) : na
if tblOn and barstate.islast
    color TX = chart.fg_color
    color MU = color.new(chart.fg_color, 45)
    color HB = color.new(chart.fg_color, 90)
    color UP = #26A69A
    color DN = #EF5350
    string res  = code == 1 ? "WAITING" : not show ? "NO 09:15 CANDLE" : kAll == 1 ? "PASS" : kAll == 0 ? "FAIL" : "DATA MISSING"
    color  resC = show and kAll == 1 ? (fcCol == -1 ? DN : UP) : MU
    f_cell(tb, 0, 0, "First candle · " + str.tostring(timeframe.multiplier) + " min", TX, HB)
    f_cell(tb, 1, 0, code == 1 or na(fcT) ? "not closed yet" : str.format_time(fcT, "dd MMM yyyy HH:mm", syminfo.timezone), TX, HB)
    f_cell(tb, 2, 0, res, resC, HB)

    string colRule = bullOn and bearOn ? "green or red" : bullOn ? "green" : bearOn ? "red" : "any"
    f_cell(tb, 0, 1, "1·2 · Colour: " + colRule, TX)
    f_cell(tb, 1, 1, show ? (fcCol == 1 ? "Green" : fcCol == -1 ? "Red" : "Doji") : "–", show and fcCol == 1 ? UP : show and fcCol == -1 ? DN : MU)
    f_cell(tb, 2, 1, show ? f_ok(kCol, bullOn or bearOn) : "–", TX)

    f_cell(tb, 0, 2, "3 · ΔOI ≥ " + str.tostring(oiPct) + "% of avg", oiOn ? TX : MU)
    f_cell(tb, 1, 2, show and FUT_ON ? f_k(fcDoi) + " · " + f_p(oOIp) + " of avg " + f_k(refOI) : "–", MU)
    f_cell(tb, 2, 2, show ? f_ok(kOI, oiOn) : "–", TX)

    f_cell(tb, 0, 3, "4 · OV ratio ≥ " + str.tostring(ovPct) + "% of avg", ovOn ? TX : MU)
    f_cell(tb, 1, 3, show and FUT_ON ? f_p(fcOv) + " · " + f_p(oOVp) + " of avg " + f_p(refOV) : "–", MU)
    f_cell(tb, 2, 3, show ? f_ok(kOV, ovOn) : "–", TX)

    string chTxt = not chOn ? "not loaded (check 5 is off)" : chCd == 0 ? f_p(chSh) + " · biggest child at " + str.format_time(chT, CH_SEC < 60 ? "HH:mm:ss" : "HH:mm", syminfo.timezone) : chCd == 2 ? "the child must be shorter than the chart candle" : chCd == 3 ? "children hold " + f_p(chCov) + " of the candle's volume, not 100%" : "no child data"
    f_cell(tb, 0, 4, "5 · Child ≥ " + str.tostring(chPct) + "% (" + chTf + ")", chOn ? TX : MU)
    f_cell(tb, 1, 4, show ? chTxt : "–", MU)
    f_cell(tb, 2, 4, show ? f_ok(kCh, chOn) : "–", TX)

    f_cell(tb, 0, 5, "6 · Prev day's VWAP (" + (PD_FIRST ? "first candle's close" : "latest close") + ")", pdOn ? TX : MU)
    f_cell(tb, 1, 5, show ? f_sp(oPd) + " · VWAP " + f_px(pdVw) : "–", MU)
    f_cell(tb, 2, 5, show ? f_ok(kPd, pdOn) : "–", TX)

    f_cell(tb, 0, 6, "Average", MU)
    f_cell(tb, 1, 6, FUT_ON ? str.tostring(refN) + " of the last " + str.tostring(refS) + " candles added OI" : "not loaded (checks 3 and 4 are off)", MU)
    f_cell(tb, 2, 6, "", MU)

    string why = ""
    if code == 0
        why := "all data present for the ticked checks"
    else if code == 1
        why := "the session's first candle has not closed yet"
    else if code == 2
        why := "the session has no candle starting at 09:15"
    else if code == 3
        why := futCd == 2 ? "contract-roll morning: 1! and 2! switched contracts" : futCd == 3 ? "OV ratio above 100%: OI and volume are not from the same window" : "futures OI or volume missing, or not stamped to the first candle"
    else if code == 4
        why := "no candle that added OI is loaded yet"
    else if code == 5
        why := chTxt
    else
        why := "no full previous session is loaded"
    f_cell(tb, 0, 7, "Data " + str.tostring(code), MU)
    f_cell(tb, 1, 7, why + " · " + FUT1 + " + " + FUT2, MU)
    f_cell(tb, 2, 7, "", MU)
